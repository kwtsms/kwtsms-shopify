generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id @db.VarChar(200)
  shop          String    @db.VarChar(100)
  state         String    @db.VarChar(200)
  isOnline      Boolean   @default(false)
  scope         String?   @db.Text
  expires       DateTime?
  accessToken   String    @db.Text
  userId        BigInt?
  firstName     String?   @db.VarChar(100)
  lastName      String?   @db.VarChar(100)
  email         String?   @db.VarChar(255)
  accountOwner  Boolean   @default(false)
  locale        String?   @db.VarChar(10)
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?  @db.Text
  refreshTokenExpires DateTime?
}

model GatewayCredentials {
  id                  Int       @id @default(autoincrement())
  shop                String    @unique @db.VarChar(100)
  username            String    @db.VarChar(100)
  password            String    @db.VarChar(500)
  senderId            String    @default("") @db.VarChar(50)
  testMode            Boolean   @default(true)
  senderIds           String    @db.Text
  coverage            String    @db.Text
  balanceAvailable    Float     @default(0)
  balancePurchased    Float     @default(0)
  balanceUpdatedAt    DateTime?
  // 2026-11-11 16:06 +03: time of the last balance sync attempt (success or not), so a failed sync is tried at most once an hour, task shopify-review-hotfix
  syncAttemptedAt     DateTime?
  credentialsVerified Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Settings {
  id        Int      @id @default(autoincrement())
  shop      String   @db.VarChar(100)
  key       String   @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, key])
  @@index([shop])
}

model SmsTemplate {
  id            Int      @id @default(autoincrement())
  shop          String   @db.VarChar(100)
  eventType     String   @db.VarChar(50)
  enabled       Boolean  @default(true)
  templateEn    String   @db.Text
  templateAr    String   @db.Text
  recipientType String   @default("customer") @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, eventType])
  @@index([shop])
}

model SmsLog {
  id               Int      @id @default(autoincrement())
  shop             String   @db.VarChar(100)
  eventType        String   @db.VarChar(50)
  phone            String   @db.VarChar(50)
  recipientType    String   @default("customer") @db.VarChar(20)
  message          String   @db.Text
  senderId         String   @db.VarChar(50)
  status           String   @db.VarChar(20)
  msgId            String?  @db.VarChar(100)
  pointsCharged    Int      @default(0)
  balanceAfter     Float?
  errorCode        String?  @db.VarChar(20)
  errorDescription String?  @db.VarChar(255)
  apiResponse      String?  @db.Text
  testMode         Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([shop])
  @@index([createdAt])
  @@index([shop, eventType])
}

// 2026-11-11 16:11 +03: one row per handled Shopify webhook delivery (X-Shopify-Webhook-Id), unique, kept 7 days, so a repeated
// delivery of the same webhook does not send the SMS again, task shopify-review-hotfix
model WebhookDelivery {
  id        Int      @id @default(autoincrement())
  webhookId String   @unique @db.VarChar(100)
  shop      String   @db.VarChar(100)
  topic     String   @db.VarChar(50)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
